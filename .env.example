# Salin file ini jadi .env.local lalu isi sesuai kebutuhan.

# URL app (dipakai untuk OAuth redirect Google Search Console)
APP_URL=http://localhost:3000

# Jadwal auto-check rank (format cron). Default: tiap hari jam 06:00.
RANK_CRON=0 6 * * *

# Google Search Console OAuth (opsional — lihat README bagian GSC)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kalau tidak diisi, default: {APP_URL}/api/gsc/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/gsc/callback
